# All variables are optional. Prefer `myfitnesspal-mcp auth` (0600 cookies.json)
# over putting a session cookie in this file or in MCP client JSON.
# See SECURITY_REVIEW.md before pointing this at a live account.
#
# If you set MFP_COOKIE here, chmod this file 0600 and never commit it.
# The cookie is full MyFitnessPal account access.

# Session cookie: prefer the bare __Secure-next-auth.session-token value.
# Do not paste a Cookie header copied from another site.
# MFP_COOKIE=

# Your MyFitnessPal username (not email). Only needed if MFP's profile endpoint
# fails for your account (the server will tell you).
# MFP_USERNAME=

# Browser fingerprint for Cloudflare. Try chrome124 etc. if you get 403s.
# MFP_IMPERSONATE=chrome

# How many days back to gap-fill the local cache (default 30).
# MFP_SYNC_DAYS=30

# Where to keep the local SQLite cache (default: platform data dir).
# MFP_MCP_DATA_DIR=

# Reject tools that write to MyFitnessPal (log/delete/modify food, weight, notes).
# Recommended for first live use. Unset only if you accept model-driven writes.
# MFP_READ_ONLY=1
