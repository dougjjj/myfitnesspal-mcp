# All variables are optional. Run `myfitnesspal-mcp auth` for the guided setup instead.

# MyFitnessPal session cookie: either the full Cookie header from a logged-in
# browser request, or just the value of __Secure-next-auth.session-token.
# MFP_COOKIE=

# Your MyFitnessPal username (not email). Only needed if MFP's profile endpoint
# fails for your account (the server will tell you).
# MFP_USERNAME=

# Browser fingerprint for Cloudflare. Try chrome124 etc. if you get 403s.
# MFP_IMPERSONATE=chrome

# How many days back to gap-fill the local cache (default 30).
# MFP_SYNC_DAYS=30

# Where to keep the local SQLite cache (default: platform data dir).
# MFP_MCP_DATA_DIR=

# Write tools (log, edit, delete, local feel notes and pins) are off unless this
# is set. MFP_READ_ONLY=1 forces them off even if this is set.
# MFP_ALLOW_WRITES=1

# With MFP_ALLOW_WRITES=1, limit which write tools exist. `food` is
# fitness_log_food, fitness_delete_food, and fitness_modify_food.
# Search stays available because it is a read. Unset means every write tool.
# MFP_WRITE_TOOLS=food

# Headless Chromium session refresh. Off even if the [autorefresh] extra is
# installed, until this is set.
# MFP_AUTOREFRESH=1

# Required for --http. A shared secret of at least 16 characters. The client
# sends it as: Authorization: Bearer <token>
# MFP_HTTP_TOKEN=

# Allow --host other than 127.0.0.1 / localhost / ::1. Still requires the token.
# Set MFP_HTTP_ALLOWED_HOSTS to the hostname or IP clients will use.
# MFP_HTTP_ALLOW_LAN=1
# MFP_HTTP_ALLOWED_HOSTS=192.168.1.20
